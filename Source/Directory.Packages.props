<Project>

  <PropertyGroup>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	<CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- All shipping libraries target net8.0/netstandard2.0, so a single version lane covers
	   every project. Test projects additionally run on net10.0, where these 8.0.x assets are
	   used unchanged by the newer runtime. Versions are the lowest that still build and scan
	   clean; only entries actually referenced by a project in Scotec.Ssc.sln are declared. -->

  <ItemGroup Label="Microsoft.Extensions">
	<PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
	<PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.0" />
	<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
	<PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
	<PackageVersion Include="System.IO.Packaging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core / Blazor">
	<PackageVersion Include="Markdig" Version="0.39.1" />
  </ItemGroup>

  <ItemGroup Label="Azure">
	<PackageVersion Include="Azure.Core" Version="1.44.1" />
	<PackageVersion Include="Azure.Storage.Blobs" Version="12.23.0" />
  </ItemGroup>

  <ItemGroup Label="AWS / Identity">
	<PackageVersion Include="AWSSDK.S3" Version="3.7.410.11" />
	<PackageVersion Include="Microsoft.Identity.Client.Broker" Version="4.87.0" />
	<PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.87.0" />
  </ItemGroup>

  <ItemGroup Label="Third party">
	<PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="14.16.0" />
	<PackageVersion Include="OMS.Deep" Version="3.0.1" />
  </ItemGroup>

  <!-- MailKit/MimeKit are consumed directly by Scotec.Smtp.Service; the version is kept current
	   because 4.11.0 and earlier are vulnerable. AngleSharp (via bunit) and System.Text.Json (via
	   the Microsoft.Extensions.Configuration stack) are transitive only, and since transitive
	   pinning is disabled the consuming projects must reference them explicitly to raise them
	   above the vulnerable versions. -->
  <ItemGroup Label="Security driven dependencies">
	<PackageVersion Include="AngleSharp" Version="1.8.1" />
	<PackageVersion Include="MailKit" Version="4.18.0" />
	<PackageVersion Include="MimeKit" Version="4.18.0" />
	<PackageVersion Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Label="Testing">
	<PackageVersion Include="bunit" Version="1.37.7" />
	<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
	<PackageVersion Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

</Project>
